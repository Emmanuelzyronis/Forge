[0.4, "o", "  \u2588\u2588\u2551     \u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u2588\u2588\u2551  \u2588\u2588\u2551\u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\r\n"]
[0.42, "o", "  \u255a\u2550\u255d      \u255a\u2550\u2550\u2550\u2550\u2550\u255d \u255a\u2550\u255d  \u255a\u2550\u255d \u255a\u2550\u2550\u2550\u2550\u2550\u255d \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d\r\n"]
[0.43, "o", "\u001b[0m"]
[0.47, "o", "  \u001b[2mDistributed job execution \u2014 PostgreSQL is the queue\u001b[0m\r\n"]
[0.49, "o", "  \u001b[2mNo Redis. No RabbitMQ. No broker.\u001b[0m\r\n"]
[0.5, "o", "\r\n\r\n"]
[0.53, "o", "  \u001b[38;5;245mStack:\u001b[0m  PostgreSQL 16 \u00b7 Go 1.25 \u00b7 Docker Compose\r\n"]
